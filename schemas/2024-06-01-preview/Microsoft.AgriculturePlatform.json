{
  "id": "https://schema.management.azure.com/schemas/2024-06-01-preview/Microsoft.AgriculturePlatform.json#",
  "title": "Microsoft.AgriculturePlatform",
  "description": "Microsoft AgriculturePlatform Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "agriServices": {
      "description": "Microsoft.AgriculturePlatform/agriServices",
      "properties": {
        "apiVersion": {
          "enum": [
            "2024-06-01-preview"
          ],
          "type": "string"
        },
        "identity": {
          "description": "The managed service identities assigned to this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/ManagedServiceIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "pattern": "^[a-zA-Z0-9-]{3,24}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/AgriServiceResourceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sku": {
          "description": "The SKU (Stock Keeping Unit) assigned to this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/Sku"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.AgriculturePlatform/agriServices"
          ],
          "type": "string"
        }
      },
      "required": [
        "location",
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "AgriServiceConfig": {
      "properties": {},
      "type": "object"
    },
    "AgriServiceResourceProperties": {
      "properties": {
        "config": {
          "description": "Config of the AgriService instance.",
          "oneOf": [
            {
              "$ref": "#/definitions/AgriServiceConfig"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "dataConnectorCredentials": {
          "description": "Data connector credentials of AgriService instance.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/DataConnectorCredentialMap"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "installedSolutions": {
          "description": "AgriService installed solutions.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/InstalledSolutionMap"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "DataConnectorCredentialMap": {
      "properties": {
        "key": {
          "description": "The key representing the credential.",
          "type": "string"
        },
        "value": {
          "description": "The data connector credential value.",
          "oneOf": [
            {
              "$ref": "#/definitions/DataConnectorCredentials"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "DataConnectorCredentials": {
      "properties": {
        "clientId": {
          "description": "Client Id associated with the provider, if type of credentials is OAuthClientCredentials.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "keyName": {
          "description": "Name of the key vault key.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "keyVaultUri": {
          "description": "Uri of the key vault",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "keyVersion": {
          "description": "Version of the key vault key.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "kind": {
          "description": "Type of credential.",
          "oneOf": [
            {
              "enum": [
                "OAuthClientCredentials",
                "ApiKeyAuthCredentials"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "InstalledSolutionMap": {
      "properties": {
        "key": {
          "description": "The key representing the installed solution.",
          "type": "string"
        },
        "value": {
          "description": "The installed solution value.",
          "oneOf": [
            {
              "$ref": "#/definitions/Solution"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "ManagedServiceIdentity": {
      "properties": {
        "type": {
          "description": "Type of managed service identity (where both SystemAssigned and UserAssigned types are allowed).",
          "oneOf": [
            {
              "enum": [
                "None",
                "SystemAssigned",
                "UserAssigned",
                "SystemAssigned,UserAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "userAssignedIdentities": {
          "description": "The set of user assigned identities associated with the resource. The userAssignedIdentities dictionary keys will be ARM resource ids in the form: '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identityName}. The dictionary values can be empty objects ({}) in requests.",
          "oneOf": [
            {
              "additionalProperties": {
                "$ref": "#/definitions/UserAssignedIdentity"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Sku": {
      "properties": {
        "capacity": {
          "description": "If the SKU supports scale out/in then the capacity integer should be included. If scale out/in is not possible for the resource this may be omitted.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "family": {
          "description": "If the service has different generations of hardware, for the same SKU, then that can be captured here.",
          "type": "string"
        },
        "name": {
          "description": "The name of the SKU. E.g. P3. It is typically a letter+number code",
          "type": "string"
        },
        "size": {
          "description": "The SKU size. When the name field is the combination of tier and some other value, this would be the standalone code.",
          "type": "string"
        },
        "tier": {
          "description": "This field is required to be implemented by the Resource Provider if the service has more than one tier, but is not required on a PUT.",
          "oneOf": [
            {
              "enum": [
                "Free",
                "Basic",
                "Standard",
                "Premium"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Solution": {
      "properties": {
        "applicationName": {
          "description": "Application name of the solution.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "marketPlacePublisherId": {
          "description": "Marketplace publisher Id.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "partnerId": {
          "description": "Partner Id.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "planId": {
          "description": "Plan Id.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "saasSubscriptionId": {
          "description": "Saas subscription Id.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "saasSubscriptionName": {
          "description": "Saas subscription name.",
          "oneOf": [
            {
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "TrackedResourceTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    },
    "UserAssignedIdentities": {
      "additionalProperties": {
        "$ref": "#/definitions/UserAssignedIdentity"
      },
      "properties": {},
      "type": "object"
    },
    "UserAssignedIdentity": {
      "properties": {},
      "type": "object"
    }
  }
}