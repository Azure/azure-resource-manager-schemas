    "Datastore": {
      "properties": {
        "adxClusterResourceId": {
          "description": "The Azure resource ID of an Azure Data Explorer cluster.",
          "type": "string"
        },
        "kustoClusterDisplayName": {
          "description": "The Kusto cluster display name.",
          "type": "string"
