            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "principalType": {
          "description": "The type of the Entra ID principal.",
          "oneOf": [
            {
              "enum": [
                "Unknown",
                "User",
                "Group",
                "ServicePrincipal"
              ],
              "type": "string"
            },
