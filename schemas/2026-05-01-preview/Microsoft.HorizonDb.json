    "HorizonDbAdministratorPropertiesForAddOrHorizonDbAdministratorProperties": {
      "properties": {
        "principalName": {
          "description": "The display name or UPN of the Entra ID principal. For users, typically the User Principal Name (e.g., admin@contoso.com). For groups, the group display name. For service principals, the application display name.",
