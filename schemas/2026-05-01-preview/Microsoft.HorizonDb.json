              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tenantId": {
          "description": "The Entra ID tenant identifier (an RFC 4122 GUID). If omitted, defaults to the tenant of the subscription.",
          "type": "string"
