{
  "id": "https://schema.management.azure.com/schemas/2026-06-01-preview/Microsoft.EdgeOperator.json#",
  "title": "Microsoft.EdgeOperator",
  "description": "Microsoft EdgeOperator Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "subscription_resourceDefinitions": {
    "systemConfiguration": {
      "description": "Microsoft.EdgeOperator/systemConfiguration",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-06-01-preview"
          ],
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "enum": [
                "default"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/SystemConfigurationProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.EdgeOperator/systemConfiguration"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "SystemConfigurationProperties": {
      "properties": {
        "connectionIntent": {
          "description": "The connection intent for the system. Not yet set until configured.",
          "oneOf": [
            {
              "enum": [
                "Connected",
                "Disconnected"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "deviceResourceId": {
          "description": "The resource ID of the device associated with this system configuration. Not yet set until configured.",
          "type": "string"
        },
        "dnsForwarderIpAddress": {
          "description": "The IP address of the DNS forwarder used by the system. Not yet set until configured.",
          "type": "string"
        },
        "stampId": {
          "description": "The identifier of the stamp hosting the system. Must be a valid GUID. Not yet set until configured.",
          "oneOf": [
            {
              "pattern": "^[{]?[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}[}]?$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    }
  }
