              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "partnerProperties": {
          "description": "Partner-specific (Kore) Workspace properties.",
          "oneOf": [
            {
              "$ref": "#/definitions/WorkspacePartnerProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
