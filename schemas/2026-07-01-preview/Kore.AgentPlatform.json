            {
              "$ref": "#/definitions/OrganizationPartnerProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "user": {
          "description": "Azure customer profile metadata used by the partner for JIT provisioning.",
          "oneOf": [
            {
              "$ref": "#/definitions/UserDetails"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
