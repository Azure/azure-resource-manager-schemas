        "ownerEmail": {
          "description": "Initial owner email for the Organization. JIT-provisioned by the partner if the user does not already exist.",
          "oneOf": [
            {
              "pattern": "^[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$",
              "type": "string"
