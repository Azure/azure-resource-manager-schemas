            {
              "maxLength": 100,
              "minLength": 2,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "product": {
          "description": "Marketplace product selected for this Workspace.",
          "oneOf": [
            {
              "enum": [
                "aiforwork",
                "aiforservice"
              ],
              "type": "string"
