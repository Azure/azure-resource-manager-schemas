    "OrganizationPartnerProperties": {
      "properties": {
        "billingEmail": {
          "description": "Billing contact email address for the Organization.",
          "oneOf": [
            {
              "pattern": "^[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "defaultWorkspace": {
          "description": "Default Workspace created atomically with the Organization.\nRequired at create time and immutable thereafter.\nAfter create, manage workspaces (including this default) via the standard\nWorkspace child resource operations.",
