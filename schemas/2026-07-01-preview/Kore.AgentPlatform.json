  "definitions": {
    "CompanyDetails": {
      "properties": {
        "businessType": {
          "description": "Industry or line of business.",
          "type": "string"
        },
        "companyName": {
          "description": "Company name.",
          "type": "string"
        },
        "country": {
          "description": "Country or region of the company.",
          "type": "string"
        },
        "domain": {
          "description": "Primary domain of the company.",
          "type": "string"
        },
        "numberOfEmployees": {
          "description": "Approximate number of employees.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "officeAddress": {
          "description": "Office address of the company.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DefaultWorkspaceProperties": {
      "properties": {
        "marketplaceDetails": {
          "description": "Azure Marketplace SaaS subscriptions linked to this Workspace.\nAt least one entry is required. Mutable to support Marketplace-driven\nplan changes.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/LiftrBaseMarketplaceDetails"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "name": {
          "description": "Display name of the default Workspace.",
