{
  "id": "https://schema.management.azure.com/schemas/2026-09-01-preview/Microsoft.Security.json#",
  "title": "Microsoft.Security",
  "description": "Microsoft Security Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "serviceEntitlements": {
      "description": "Microsoft.Security/serviceEntitlements",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-09-01-preview"
          ],
          "type": "string"
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "pattern": "^[a-z0-9]{3,24}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/ServiceEntitlementProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Security/serviceEntitlements"
          ],
          "type": "string"
        }
      },
      "required": [
        "location",
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "ServiceEntitlementProperties": {
      "properties": {
        "serviceType": {
          "description": "The service associated with the service entitlement. Current supported Value is Perception.",
          "type": "string"
        },
        "state": {
          "description": "Indicates whether the service entitlement is enabled.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "serviceType",
        "state"
      ],
      "type": "object"
    },
    "TrackedResourceTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    }
  }
}