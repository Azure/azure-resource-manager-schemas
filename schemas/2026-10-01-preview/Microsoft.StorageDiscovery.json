{
  "id": "https://schema.management.azure.com/schemas/2026-10-01-preview/Microsoft.StorageDiscovery.json#",
  "title": "Microsoft.StorageDiscovery",
  "description": "Microsoft StorageDiscovery Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "storageDiscoveryWorkspaces": {
      "description": "Microsoft.StorageDiscovery/storageDiscoveryWorkspaces",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-10-01-preview"
          ],
          "type": "string"
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*(-[a-zA-Z0-9]+)*$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/StorageDiscoveryWorkspaceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.StorageDiscovery/storageDiscoveryWorkspaces"
          ],
          "type": "string"
        }
      },
      "required": [
        "location",
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "AzureBlobStorageCapability": {
      "properties": {
        "capacityDetails": {
          "description": "The capacity details configuration for Azure Blob Storage.",
          "oneOf": [
            {
              "$ref": "#/definitions/CapacityDetails"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "prefixConfigurations": {
          "description": "The prefix configurations that scope the capacity details to specific storage accounts, containers, and prefixes.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/PrefixConfiguration"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "capacityDetails"
      ],
      "type": "object"
    },
    "CapacityDetails": {
      "properties": {
        "status": {
          "description": "The enablement status of the capacity details capability.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "PrefixConfiguration": {
      "properties": {
        "containerName": {
          "description": "The name of the blob container within the storage account.",
          "oneOf": [
            {
              "maxLength": 63,
              "minLength": 3,
              "pattern": "^[a-z0-9]([a-z0-9]|(-(?!-))){1,61}[a-z0-9]$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "prefix": {
          "description": "The blob prefix within the container to scope capacity details to. An empty value scopes to the entire container. Must not start with a '/'.",
          "oneOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "storageAccountName": {
          "description": "The name of the storage account.",
          "oneOf": [
            {
              "maxLength": 24,
              "minLength": 3,
              "pattern": "^[a-z0-9]{3,24}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "containerName",
        "storageAccountName"
      ],
      "type": "object"
    },
    "StorageDiscoveryCapabilities": {
      "properties": {
        "azureBlobStorage": {
          "description": "The Azure Blob Storage capability configuration for the storage discovery workspace.",
          "oneOf": [
            {
              "$ref": "#/definitions/AzureBlobStorageCapability"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "azureBlobStorage"
      ],
      "type": "object"
    },
    "StorageDiscoveryScope": {
      "properties": {
        "displayName": {
          "description": "Display name of the collection",
          "oneOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "pattern": "^[a-zA-Z0-9]+([ -][a-zA-Z0-9]+)*$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "resourceTypes": {
          "description": "Resource types for the collection",
          "oneOf": [
            {
              "items": {
                "enum": [
                  "Microsoft.Storage/storageAccounts"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tagKeysOnly": {
          "description": "The storage account tags keys to filter",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "displayName",
        "resourceTypes"
      ],
      "type": "object"
    },
    "StorageDiscoveryScopeTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    },
    "StorageDiscoveryWorkspaceProperties": {
      "properties": {
        "capabilities": {
          "description": "The capabilities configured for the storage discovery workspace.",
          "oneOf": [
            {
              "$ref": "#/definitions/StorageDiscoveryCapabilities"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "description": {
          "description": "The description of the storage discovery workspace",
          "type": "string"
        },
        "scopes": {
          "description": "The scopes of the storage discovery workspace.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/StorageDiscoveryScope"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sku": {
          "description": "The storage discovery sku",
          "oneOf": [
            {
              "enum": [
                "Standard",
                "Free"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "workspaceRoots": {
          "description": "The view level storage discovery data estate",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "scopes",
        "workspaceRoots"
      ],
      "type": "object"
    },
    "TrackedResourceTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    }
  }
}