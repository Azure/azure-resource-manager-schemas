{
  "id": "https://schema.management.azure.com/schemas/2026-10-31-preview/Microsoft.Sovereign.json#",
  "title": "Microsoft.Sovereign",
  "description": "Microsoft Sovereign Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "sovereignViews": {
      "description": "Microsoft.Sovereign/sovereignViews",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-10-31-preview"
          ],
          "type": "string"
        },
        "identity": {
          "description": "The managed service identities assigned to this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/SystemAssignedServiceIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "pattern": "^[a-zA-Z0-9-]{3,64}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/SovereignViewResourceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.Sovereign/sovereignViews"
          ],
          "type": "string"
        }
      },
      "required": [
        "location",
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "SovereignViewDataResidencyDimensionSettings": {
      "properties": {
        "parameters": {
          "description": "Parameters used by the Data Residency evaluation.",
          "oneOf": [
            {
              "$ref": "#/definitions/SovereignViewDataResidencyParameters"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "resourceEvaluationScope": {
          "description": "The resource scope evaluated for the Data Residency dimension.",
          "oneOf": [
            {
              "enum": [
                "Residency360",
                "ResourceOnly"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "parameters",
        "resourceEvaluationScope"
      ],
      "type": "object"
    },
    "SovereignViewDataResidencyParameters": {
      "properties": {
        "allowedLocations": {
          "description": "Azure regions in which the resource and its linked resources are allowed to reside.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "allowedLocations"
      ],
      "type": "object"
    },
    "SovereignViewDimensionSettings": {
      "properties": {
        "dataResidency": {
          "description": "Settings for the Data Residency dimension.",
          "oneOf": [
            {
              "$ref": "#/definitions/SovereignViewDataResidencyDimensionSettings"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SovereignViewManagementGroupScope": {
      "properties": {
        "id": {
          "description": "The resource identifier of the management group.",
          "type": "string"
        },
        "name": {
          "description": "The management group name. This is a purely client side label that the service does not validate, normalize, or use for any lookup.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SovereignViewPolicyInitiativeDetail": {
      "properties": {
        "dimension": {
          "description": "The compliance dimension associated with the policy initiative.",
          "oneOf": [
            {
              "enum": [
                "DataResidency",
                "EncryptionAtRest",
                "EncryptionInTransit",
                "EncryptionInUse",
                "ControlledNetworkExposure",
                "BusinessContinuity"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "policyAssignmentIds": {
          "description": "The resource identifiers of existing policy assignments association with the policy initiative and scopes in the sovereign view.",
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "policyInitiativeId": {
          "description": "The fully qualified id of the policy initiative.",
          "type": "string"
        },
        "policyVersion": {
          "description": "The version of the policy initiative.",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "policyAssignmentIds",
        "policyInitiativeId",
        "policyVersion"
      ],
      "type": "object"
    },
    "SovereignViewResourceProperties": {
      "properties": {
        "dimensionSettings": {
          "description": "Optional per-dimension evaluation settings.",
          "oneOf": [
            {
              "$ref": "#/definitions/SovereignViewDimensionSettings"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "isWorkload": {
          "description": "Indicates whether the Sovereign View is considered a workload.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "policyInitiatives": {
          "description": "The policy initiatives selected for the sovereign view.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/SovereignViewPolicyInitiativeDetail"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "regulatoryDocumentName": {
          "description": "Stable regulatory-document key selected when this Sovereign View was created.",
          "oneOf": [
            {
              "enum": [
                "SovereignControlBaseline"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "scope": {
          "description": "The scope to apply for configuration.",
          "oneOf": [
            {
              "$ref": "#/definitions/SovereignViewScope"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "policyInitiatives",
        "scope"
      ],
      "type": "object"
    },
    "SovereignViewScope": {
      "properties": {
        "managementGroups": {
          "description": "The management groups in scope.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/SovereignViewManagementGroupScope"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "subscriptions": {
          "description": "The subscriptions in scope.",
          "oneOf": [
            {
              "items": {
                "$ref": "#/definitions/SovereignViewSubscriptionScope"
              },
              "type": "array"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "SovereignViewSubscriptionScope": {
      "properties": {
        "id": {
          "description": "The subscription id.",
          "oneOf": [
            {
              "maxLength": 36,
              "minLength": 36,
              "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "name": {
          "description": "The subscription name. This is a purely client side label that the service does not validate, normalize, or use for any lookup.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SystemAssignedServiceIdentity": {
      "properties": {
        "type": {
          "description": "Type of managed service identity (either system assigned, or none).",
          "oneOf": [
            {
              "enum": [
                "None",
                "SystemAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TrackedResourceTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    }
  }
}