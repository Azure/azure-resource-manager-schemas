    "RuntimeLinkIntegrationProfile": {
      "description": "Identity configuration used to integrate runtime bindings.",
      "properties": {
        "managedIdentityResourceId": {
          "description": "The user-assigned identity used by the provider integration.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "RuntimeLinkProperties": {
      "description": "Properties of a relationship between runtime bindings.",
      "properties": {
        "capacityProfile": {
          "description": "The mutable capacity policy for the runtime composition.",
