        },
        "executionBindingResourceId": {
          "description": "The optional sibling runtime binding that provides execution.",
          "type": "string"
        },
        "integrationProfile": {
          "description": "The provider integration identity configuration.",
          "oneOf": [
            {
              "$ref": "#/definitions/RuntimeLinkIntegrationProfile"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "orchestratorBindingResourceId": {
          "description": "The sibling runtime binding that provides orchestration.",
          "type": "string"
        }
