      "required": [
        "orchestratorBindingResourceId"
      ],
      "type": "object"
    },
    "RuntimeNetworkProfile": {
      "description": "Network configuration for a managed runtime.",
      "properties": {
        "egressMode": {
          "description": "Indicates who manages runtime egress.",
