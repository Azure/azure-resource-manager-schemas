{
  "id": "https://schema.management.azure.com/schemas/2026-11-01-preview/Microsoft.LoadTestService.json#",
  "title": "Microsoft.LoadTestService",
  "description": "Microsoft LoadTestService Resource Types",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "resourceDefinitions": {
    "playwrightWorkspaces": {
      "description": "Microsoft.LoadTestService/playwrightWorkspaces",
      "properties": {
        "apiVersion": {
          "enum": [
            "2026-11-01-preview"
          ],
          "type": "string"
        },
        "identity": {
          "description": "The managed service identities assigned to this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/ManagedServiceIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "location": {
          "description": "The geo-location where the resource lives",
          "type": "string"
        },
        "name": {
          "description": "The resource name",
          "oneOf": [
            {
              "pattern": "^[a-zA-Z0-9-]{3,24}$",
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "properties": {
          "description": "The resource-specific properties for this resource.",
          "oneOf": [
            {
              "$ref": "#/definitions/PlaywrightWorkspaceProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "tags": {
          "description": "Resource tags.",
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "type": {
          "enum": [
            "Microsoft.LoadTestService/playwrightWorkspaces"
          ],
          "type": "string"
        }
      },
      "required": [
        "location",
        "name",
        "properties",
        "apiVersion",
        "type"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "LinkedKeyVaultProperties": {
      "properties": {
        "vaultIdentity": {
          "description": "The managed identity used to access the linked Azure Key Vault.",
          "oneOf": [
            {
              "$ref": "#/definitions/ManagedIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "vaultUri": {
          "description": "The URI of the linked Azure Key Vault.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ManagedIdentity": {
      "properties": {
        "resourceId": {
          "description": "The Azure Resource Manager resource ID of the user-assigned managed identity. Required when type is UserAssigned. Omit when type is SystemAssigned.",
          "type": "string"
        },
        "type": {
          "description": "The managed identity type: SystemAssigned or UserAssigned.",
          "oneOf": [
            {
              "enum": [
                "SystemAssigned",
                "UserAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "type": "object"
    },
    "ManagedServiceIdentity": {
      "properties": {
        "type": {
          "description": "Type of managed service identity (where both SystemAssigned and UserAssigned types are allowed).",
          "oneOf": [
            {
              "enum": [
                "None",
                "SystemAssigned",
                "UserAssigned",
                "SystemAssigned,UserAssigned"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "userAssignedIdentities": {
          "description": "The set of user assigned identities associated with the resource. The userAssignedIdentities dictionary keys will be ARM resource ids in the form: '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identityName}. The dictionary values can be empty objects ({}) in requests.",
          "oneOf": [
            {
              "additionalProperties": {
                "$ref": "#/definitions/UserAssignedIdentity"
              },
              "properties": {},
              "type": "object"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "ManagedServiceIdentityUserAssignedIdentities": {
      "additionalProperties": {
        "$ref": "#/definitions/UserAssignedIdentity"
      },
      "properties": {},
      "type": "object"
    },
    "PlaywrightWorkspaceProperties": {
      "properties": {
        "browserProxy": {
          "description": "Specifies whether the browser proxy is enabled for the workspace.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "linkedKeyVault": {
          "description": "The Azure Key Vault linked to the workspace and the managed identity used to access it.",
          "oneOf": [
            {
              "$ref": "#/definitions/LinkedKeyVaultProperties"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "localAuth": {
          "description": "Specifies whether service access tokens can be used to authenticate workspace operations.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "regionalAffinity": {
          "description": "Specifies where client workers connect to cloud-hosted browsers. When Enabled, workers connect to browsers in the nearest Azure region to reduce latency. When Disabled, workers connect to browsers in the workspace's Azure region.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "reporting": {
          "description": "Specifies whether test reporting is enabled for the workspace.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "sessionArtifacts": {
          "description": "Specifies whether session artifact recording is enabled for the workspace.",
          "oneOf": [
            {
              "enum": [
                "Enabled",
                "Disabled"
              ],
              "type": "string"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "storageIdentity": {
          "description": "The managed identity used to manage session artifacts in the storage account.",
          "oneOf": [
            {
              "$ref": "#/definitions/ManagedIdentity"
            },
            {
              "$ref": "https://schema.management.azure.com/schemas/common/definitions.json#/definitions/expression"
            }
          ]
        },
        "storageUri": {
          "description": "The URI of the Azure Storage account used to store workspace artifacts, test results, and reports.",
          "type": "string"
        },
        "subnetId": {
          "description": "The Azure Resource Manager resource ID of the subnet used for private network connectivity. Before creating the workspace, ensure the subnet meets the virtual network prerequisites at https://aka.ms/pww/docs/vnet. Format: /subscriptions/{subscriptionId}/resourceGroups/{resourceGroup}/providers/Microsoft.Network/virtualNetworks/{virtualNetwork}/subnets/{subnet}. This value cannot be changed after workspace creation.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "TrackedResourceTags": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {},
      "type": "object"
    },
    "UserAssignedIdentity": {
      "properties": {},
      "type": "object"
    }
  }
}